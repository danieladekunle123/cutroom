{
  "name": "cutroom",
  "productName": "Cutroom",
  "version": "1.0.0",
  "description": "Cut audio and video clips out of YouTube, TikTok and Twitch videos on a waveform timeline.",
  "author": "Daniel Adekunle",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/logic.test.js",
    "package": "electron-packager . Cutroom --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --ignore=\"^/(dist|test|build/icon\\.svg|README\\.md|Cutroom\\.lnk|[^/]+\\.(mp3|mp4))\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^45.2.3"
  }
}
